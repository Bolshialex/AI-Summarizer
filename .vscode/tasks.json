{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend",
      "type": "shell",
      "command": "./run_server.sh",
      "windows": { "command": "run_server.bat" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "presentation": { "group": "dev", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "frontend-install",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "presentation": { "group": "dev", "panel": "dedicated", "reveal": "silent" },
      "problemMatcher": []
    },
    {
      "label": "frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "dependsOn": ["frontend-install"],
      "dependsOrder": "sequence",
      "isBackground": true,
      "presentation": { "group": "dev", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "dev",
      "dependsOn": ["backend", "frontend"],
      "dependsOrder": "parallel",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
