# Copy this file to .env and fill in your real values.
# .env is gitignored - never commit real keys.

SUPABASE_URL=supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=supabase_service_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# DIMENSION must match the embedding model's output size and the vector(...)
# column size in db/schema.sql.
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
DIMENSION=2048
# SUMMARY_MODEL is a Groq chat model (uses GROQ_API_KEY).
SUMMARY_MODEL=llama-3.3-70b-versatile
